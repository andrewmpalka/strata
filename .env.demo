# Strata — demo mode environment.
#
# This file contains NO SECRETS and is intentionally checked in.
# The Postgres password below is a throwaway credential for a disposable,
# fixture-only local database. It is never used for anything live.
#
# Live configuration lives in .env.live, which is human-owned, gitignored,
# and must never be created, printed, or committed by an agent.

DEMO_MODE=true

# --- Postgres (official image) ---
POSTGRES_DB=strata_demo
POSTGRES_USER=strata
POSTGRES_PASSWORD=strata_demo_not_a_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Host port for ad-hoc psql access. Deliberately not 5432 so a CI stack can
# never collide with, or be mistaken for, a live stack.
POSTGRES_HOST_PORT=55432

# --- App ---
# Bound wall-clock seconds the app will spend waiting for Postgres to accept
# connections before failing loudly. Never unbounded.
DB_CONNECT_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
